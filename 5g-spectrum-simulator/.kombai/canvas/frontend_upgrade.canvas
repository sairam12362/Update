      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;500;600;700&display=swap');\n  body { background: #1D1314; font-family: 'Encode Sans', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }\n  .tnum { font-variant-numeric: tabular-nums; font-feature-settings: \"tnum\" 1; }\n</style>\n<link data-kid=\"1\" data-name=\"tabler icons webfont stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"flex min-h-screen items-stretch\" data-kid=\"2\" data-name=\"page layout container\">\n<aside class=\"w-[208px] shrink-0 flex flex-col px-4 py-5 border-r border-[#FFBF00]/15\" data-kid=\"2-1\" data-name=\"spectral dashboard sidebar\">\n<div class=\"pb-4 border-b border-[#FFBF00]/15\" data-kid=\"2-1-1\" data-name=\"sidebar header with project title\">\n<div class=\"text-[13px] font-semibold leading-[1.35] text-[#FFBF00]\" data-kid=\"2-1-1-1\" data-name=\"project title text\">Spectrum Allocation Benchmark</div>\n<div class=\"mt-3 flex items-center gap-2\" data-kid=\"2-1-1-2\" data-name=\"status indicator row\">\n<span class=\"w-1.5 h-1.5 bg-[#32936F]\" data-kid=\"2-1-1-2-1\" data-name=\"connected status dot\"></span>\n<span class=\"text-[11px] tnum text-[#FFBF00]/60\" data-kid=\"2-1-1-2-2\" data-name=\"status label text\">policy.pt loaded</span>\n</div>\n</div>\n<nav class=\"mt-4 flex flex-col\" data-kid=\"2-1-2\" data-name=\"sidebar main navigation\">\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-1\" data-name=\"navigation link (Overview)\">Overview</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] font-medium bg-[#2274A5] text-white\" data-kid=\"2-1-2-2\" data-name=\"active navigation link (Live Simulation)\">Live Simulation</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-3\" data-name=\"navigation link (Predictor)\">Predictor</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-4\" data-name=\"navigation link (Ablation)\">Ablation</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-5\" data-name=\"navigation link (Methodology)\">Methodology</a>\n</nav>\n<div class=\"mt-auto pt-4 border-t border-[#FFBF00]/15\" data-kid=\"2-1-3\" data-name=\"sidebar footer source list\">\n<div class=\"text-[11px] text-[#FFBF00]/60\" data-kid=\"2-1-3-1\" data-name=\"figure sources section label\">Run inputs</div>\n<div class=\"mt-2 text-[11px] tnum leading-[1.7] text-[#FFBF00]/70\" data-kid=\"2-1-3-2\" data-name=\"source file list container\">\n<div data-kid=\"2-1-3-2-1\" data-name=\"source file path (kpi_by_regime.csv)\">results/kpi_by_regime.csv</div>\n<div data-kid=\"2-1-3-2-2\" data-name=\"model artifact path (policy.pt)\">artifacts/policy.pt</div>\n<div data-kid=\"2-1-3-2-3\" data-name=\"source file path (env.py)\">spectrum/env.py</div>\n</div>\n</div>\n</aside>\n<main class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"2-2\" data-name=\"main content area\">\n<div class=\"h-14 shrink-0 flex items-center justify-between gap-6 px-5 border-b border-[#FFBF00]/15\" data-kid=\"2-2-1\" data-name=\"top toolbar header\">\n<div class=\"text-[13px] font-semibold text-[#FFBF00]\" data-kid=\"2-2-1-1\" data-name=\"toolbar page title\">Live Simulation</div>\n<div class=\"flex items-center gap-3 text-[11px]\" data-kid=\"2-2-1-2\" data-name=\"parameter values summary row\">\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-1\" data-name=\"carrier parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-1-1\" data-name=\"carrier parameter label\">Carrier</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-1-2\" data-name=\"carrier parameter value\">3.5 GHz</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-2\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-3\" data-name=\"bandwidth parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-3-1\" data-name=\"bandwidth parameter label\">Bandwidth</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-3-2\" data-name=\"bandwidth parameter value\">100 MHz</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-4\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-5\" data-name=\"RBG parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-5-1\" data-name=\"RBG parameter label\">RBG</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-5-2\" data-name=\"RBG parameter value\">18</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-6\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-7\" data-name=\"slot parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-7-1\" data-name=\"slot parameter label\">Slot</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-7-2\" data-name=\"slot parameter value\">0.5 ms</span></div>\n</div>\n</div>\n<div class=\"px-5 pt-4\" data-kid=\"2-2-2\" data-name=\"paired run setup strip\">\n<div class=\"h-[72px] flex items-end gap-3 px-4 pb-3 bg-[#241819]\" data-kid=\"2-2-2-1\" data-name=\"paired episode configurator panel\" style=\"box-shadow: inset 0 0 0 1px rgba(255,191,0,0.18)\">\n<div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-1-1-1\" data-name=\"allocator A selector field\">\n<span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-1-1\" data-name=\"allocator A field label\">Allocator A</span>\n<div class=\"h-9 w-[196px] flex items-center justify-between gap-2 border border-[#FFBF00]/20 px-3 text-[12px] text-[#FFBF00]/90\" data-kid=\"2-2-1-1-1-2\" data-name=\"allocator A select control\"><span data-kid=\"2-2-1-1-1-2-1\" data-name=\"allocator A selected value\">Proportional Fair</span><i class=\"ti ti-chevron-down text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-1-2-2\" data-name=\"allocator A dropdown chevron icon\"></i></div>\n</div>\n<button aria-label=\"Swap allocator A and B\" class=\"h-9 w-9 shrink-0 mb-0 flex items-center justify-center border border-[#FFBF00]/20 text-[#FFBF00]/70\" data-kid=\"2-2-1-1-2\" data-name=\"swap allocators control\"><i class=\"ti ti-arrows-exchange text-[14px]\" data-kid=\"2-2-1-1-2-1\" data-name=\"swap arrows icon\"></i></button>\n<div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-1-1-3\" data-name=\"allocator B selector field\">\n<span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-3-1\" data-name=\"allocator B field label\">Allocator B</span>\n<div class=\"h-9 w-[216px] flex items-center justify-between gap-2 border border-[#FFBF00]/20 px-3 text-[12px] text-[#FFBF00]\" data-kid=\"2-2-1-1-3-2\" data-name=\"allocator B select control\"><span data-kid=\"2-2-1-1-3-2-1\" data-name=\"allocator B selected value\">NeuroSpectrum (proposed)</span><i class=\"ti ti-chevron-down text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-3-2-2\" data-name=\"allocator B dropdown chevron icon\"></i></div>\n</div>\n<div class=\"w-px h-9 bg-[#FFBF00]/15\" data-kid=\"2-2-1-1-4\" data-name=\"setup group separator\"></div>\n<div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-1-1-5\" data-name=\"regime selector field\">\n<span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-5-1\" data-name=\"regime field label\">Regime</span>\n<div class=\"h-9 w-[104px] flex items-center justify-between gap-2 border border-[#FFBF00]/20 px-3 text-[12px] text-[#FFBF00]/90\" data-kid=\"2-2-1-1-5-2\" data-name=\"regime select control\"><span data-kid=\"2-2-1-1-5-2-1\" data-name=\"regime selected value\">high</span><i class=\"ti ti-chevron-down text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-5-2-2\" data-name=\"regime dropdown chevron icon\"></i></div>\n</div>\n<div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-1-1-6\" data-name=\"slots selector field\">\n<span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-6-1\" data-name=\"slots field label\">Slots</span>\n<div class=\"h-9 w-[86px] flex items-center justify-between gap-2 border border-[#FFBF00]/20 px-3 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-1-6-2\" data-name=\"slots numeric field\"><span data-kid=\"2-2-1-1-6-2-1\" data-name=\"slots value\">1000</span><span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-6-2-2\" data-name=\"slots step affordance\"><i class=\"ti ti-chevron-up text-[9px]\" data-kid=\"2-2-1-1-6-2-2-1\" data-name=\"step up icon\"></i><i class=\"ti ti-chevron-down text-[9px]\" data-kid=\"2-2-1-1-6-2-2-2\" data-name=\"step down icon\"></i></span></div>\n</div>\n<div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-1-1-7\" data-name=\"seed selector field\">\n<span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-7-1\" data-name=\"seed field label\">Seed</span>\n<div class=\"h-9 w-[96px] flex items-center justify-between gap-2 border border-[#FFBF00]/20 px-3 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-1-7-2\" data-name=\"seed number input control\"><span data-kid=\"2-2-1-1-7-2-1\" data-name=\"seed value\">1000</span><span class=\"text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-1-1-7-2-2\" data-name=\"seed step affordance\"><i class=\"ti ti-chevron-up text-[9px]\" data-kid=\"2-2-1-1-7-2-2-1\" data-name=\"step up icon\"></i><i class=\"ti ti-chevron-down text-[9px]\" data-kid=\"2-2-1-1-7-2-2-2\" data-name=\"step down icon\"></i></span></div>\n</div>\n<button class=\"ml-auto h-9 px-4 flex items-center gap-2 bg-[#2274A5] text-[12px] font-medium text-white\" data-kid=\"2-2-1-1-8\" data-name=\"run paired episode primary action\"><i class=\"ti ti-player-play text-[13px]\" data-kid=\"2-2-1-1-8-1\" data-name=\"run action icon\"></i><span data-kid=\"2-2-1-1-8-2\" data-name=\"run action label\">Run paired episode</span></button>\n</div>\n</div>\n<div class=\"h-10 shrink-0 flex items-center justify-between gap-6 px-5 mt-1\" data-kid=\"2-2-2-2\" data-name=\"run record line\">\n<div class=\"flex items-center gap-3 text-[11px] tnum text-[#FFBF00]/60\" data-kid=\"2-2-2-2-1\" data-name=\"run configuration field row\">\n<span data-kid=\"2-2-2-2-1-1\" data-name=\"run regime field\">regime high</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-2\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-3\" data-name=\"run UE count field\">55 UEs</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-4\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-5\" data-name=\"run load field\">load ×1.60</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-6\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-7\" data-name=\"run incumbent duty field\">incumbent duty 34%</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-8\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-9\" data-name=\"run slots field\">1000 slots</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-10\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-11\" data-name=\"run duration field\">500 ms simulated</span>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-2-1-12\" data-name=\"vertical separator\"></span>\n<span data-kid=\"2-2-2-2-1-13\" data-name=\"run seed field\">seed 1000</span>\n</div>\n<div class=\"flex items-center gap-2 text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-2-2-2\" data-name=\"run scope field\">\n<span class=\"w-1.5 h-1.5 bg-[#32936F]\" data-kid=\"2-2-2-2-2-1\" data-name=\"paired run indicator pip\"></span>\n<span class=\"tnum\" data-kid=\"2-2-2-2-2-2\" data-name=\"run scope value\">paired · 2 allocators · 9 metrics</span>\n</div>\n</div>\n<div class=\"px-5 pb-5 flex flex-col\" data-kid=\"2-2-3\" data-name=\"main content body\">\n<div class=\"grid grid-cols-[1fr_376px] gap-5\" data-kid=\"2-2-3-1\" data-name=\"waterfall and evidence column grid\">\n<div class=\"min-w-0\" data-kid=\"2-2-3-1-1\" data-name=\"occupancy waterfall column\">\n<div class=\"h-10 flex items-center justify-between gap-4\" data-kid=\"2-2-3-1-1-1\" data-name=\"occupancy section header\">\n<h2 class=\"text-[15px] font-semibold text-[#FFBF00]/90\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"occupancy section headline\">Occupancy</h2>\n<div class=\"flex items-center gap-4 text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-3-1-1-1-2\" data-name=\"occupancy legend\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-1-1-1-2-1\" data-name=\"idle legend item\"><span class=\"w-2 h-2\" data-kid=\"2-2-3-1-1-1-2-1-1\" data-name=\"idle swatch\" style=\"background:rgba(255,191,0,0.05); box-shadow:inset 0 0 0 1px rgba(255,191,0,0.18)\"></span>idle</span>\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-1-1-1-2-2\" data-name=\"clean transmit legend item\"><span class=\"w-2 h-2\" data-kid=\"2-2-3-1-1-1-2-2-1\" data-name=\"clean transmit swatch\" style=\"background:rgba(255,191,0,0.22)\"></span>clean TX</span>\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-1-1-1-2-3\" data-name=\"collision legend item\"><span class=\"w-2 h-2\" data-kid=\"2-2-3-1-1-1-2-3-1\" data-name=\"collision swatch\" style=\"background:rgba(232,63,111,0.72)\"></span>collision</span>\n</div>\n</div>\n<div class=\"bg-[#241819] px-3 pt-2.5 pb-3\" data-kid=\"2-2-3-1-1-2\" data-name=\"allocator A occupancy panel\" style=\"box-shadow: inset 0 0 0 1px rgba(255,191,0,0.18)\">\n<div class=\"h-6 flex items-center gap-3\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"allocator A panel label row\">\n<span class=\"text-[11px] font-semibold text-[#FFBF00]\" data-kid=\"2-2-3-1-1-2-1-1\" data-name=\"allocator A name\">A · Proportional Fair</span>\n<span class=\"tnum text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-1-1-2-1-2\" data-name=\"allocator A collision field\">collision