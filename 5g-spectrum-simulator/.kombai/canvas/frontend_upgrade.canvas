10171D]\" data-kid=\"1-2-3-4-4-2-2-5\" data-name=\"point-estimate circle marker\" style=\"left:24.8%;\"></span>\n</div>\n</div>\n<div class=\"flex items-center gap-2 pr-3\" data-kid=\"1-2-3-4-4-3\" data-name=\"best classical goodput value with CI error bar\">\n<span class=\"w-[104px] whitespace-nowrap text-[10px] leading-[12px] text-[#10171D]/60\" data-kid=\"1-2-3-4-4-3-1\" data-name=\"comparator name: Max-C/I\">Max-C/I</span>\n<span class=\"w-[50px] text-[12px] text-right\" data-kid=\"1-2-3-4-4-3-2\" data-name=\"comparator value: 259.593\">259.593</span>\n<div class=\"relative h-[14px] flex-1\" data-kid=\"1-2-3-4-4-3-3\" data-name=\"Certainty plot (comparator Max-C/I)\">\n<span class=\"absolute left-0 right-0 top-1/2 h-px bg-[#10171D]/25\" data-kid=\"1-2-3-4-4-3-3-1\" data-name=\"baseline reference line\"></span>\n<span class=\"absolute top-1/2 h-[2px] bg-[#10171D]/35\" data-kid=\"1-2-3-4-4-3-3-2\" data-name=\"CI horizontal bar\" style=\"left:67.2%;right:6%;\"></span>\n<span class=\"absolute top-1/2 -translate-y-1/2 h-[8px] w-px bg-[#10171D]/50\" data-kid=\"1-2-3-4-4-3-3-3\" data-name=\"CI left whisker tick\" style=\"left:67.2%;\"></span>\n<span class=\"absolute top-1/2 -translate-y-1/2 h-[8px] w-px bg-[#10171D]/50\" data-kid=\"1-2-3-4-4-3-3-4\" data-name=\"CI right whisker tick\" style=\"right:6%;\"></span>\n<span class=\"absolute top-1/2 -translate-y-1/2 h-[5px] w-[5px] rounded-full bg-[#10171D]/60\" data-kid=\"1-2-3-4-4-3-3-5\" data-name=\"point-estimate circle marker\" style=\"left:81.5%;\"></span>\n</div>\n</div>\n<div class=\"text-right text-[12px]\" data-kid=\"1-2-3-4-4-4\" data-name=\"delta value: −14.6%\">−14.6%</div>\n<div class=\"text-right text-[12px]\" data-kid=\"1-2-3-4-4-5\" data-name=\"p-value: 0.0117\">0.0117 <span class=\"text-[10px] font-semibold\" data-kid=\"1-2-3-4-4-5-1\" data-name=\"significance asterisk (bold)\">*</span></div>\n</div>\n<!-- Collisions -->\n<div class=\"grid grid-cols-[150px_270px_326px_74px_84px] items-center h-[30px]\" data