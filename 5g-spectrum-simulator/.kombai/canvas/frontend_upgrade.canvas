      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n\n.speckle-bench{\n  background-color:#EBE9E9;\n  background-image:radial-gradient(rgba(16,23,29,0.055) 0.6px, transparent 0.7px),radial-gradient(rgba(16,23,29,0.035) 0.6px, transparent 0.7px);\n  background-size:5px 5px,13px 11px;\n  background-position:0 0, 3px 4px;\n}\n.speckle-amber{\n  background-color:#FCB07E;\n  background-image:radial-gradient(rgba(16,23,29,0.07) 0.6px, transparent 0.7px);\n  background-size:6px 6px;\n}\n.occgrid{\n  background-color:#FFFFFF;\n  background-image:\n    repeating-linear-gradient(to right, rgba(16,23,29,0.05) 0 1px, transparent 1px 0.8%),\n    repeating-linear-gradient(to bottom, rgba(16,23,29,0.13) 0 1px, transparent 1px 5.5556%);\n}\n</style>\n<div class=\"min-h-screen w-full bg-[#EBE9E9] text-[#10171D] flex items-stretch\" data-kid=\"1\" data-name=\"page layout container with speckled background\" style=\"font-family:'Chivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;\">\n<!-- SIDEBAR -->\n<aside class=\"speckle-bench w-[224px] shrink-0 border-r border-[#10171D]/20 px-4 pt-4 pb-4 flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar panel with navigation and status\">\n<div class=\"pb-3 border-b border-[#10171D]/20\" data-kid=\"1-1-1\" data-name=\"sidebar branding block\">\n<div class=\"text-[13px] font-semibold leading-[1.25] tracking-[-0.01em]\" data-kid=\"1-1-1-1\" data-name=\"sidebar app title\">Spectrum Allocation<br data-kid=\"1-1-1-1-1\" data-name=\"line break in app title\"/>Benchmark</div>\n</div>\n<nav class=\"mt-3 flex flex-col gap-px\" data-kid=\"1-1-2\" data-name=\"main sidebar navigation\">\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-1\" data-name=\"Overview navigation item\">\n<i class=\"ph ph-chart-line-up text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-1-1\" data-name=\"line chart icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-1-2\" data-name=\"Overview navigation label\">Overview</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] bg-white px-2.5\" data-kid=\"1-1-2-2\" data-name=\"active Live Simulation navigation item\">\n<i class=\"ph ph-play-circle text-[14px] leading-none text-[#10171D]/65\" data-kid=\"1-1-2-2-1\" data-name=\"play circle icon\"></i>\n<span class=\"text-[13px] font-semibold leading-none border-b-2 border-[#FCB07E] pb-[3px]\" data-kid=\"1-1-2-2-2\" data-name=\"Live Simulation navigation label with amber underline\">Live Simulation</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-3\" data-name=\"Predictor navigation item\">\n<i class=\"ph ph-waveform text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-3-1\" data-name=\"waveform icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-3-2\" data-name=\"Predictor navigation label\">Predictor</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-4\" data-name=\"Ablation navigation item\">\n<i class=\"ph ph-sliders-horizontal text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-4-1\" data-name=\"horizontal sliders icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-4-2\" data-name=\"Ablation navigation label\">Ablation</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-5\" data-name=\"Methodology navigation item\">\n<i class=\"ph ph-book-open-text text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-5-1\" data-name=\"open book text icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-5-2\" data-name=\"Methodology navigation label\">Methodology</span>\n</div>\n</nav>\n<div class=\"mt-4 pt-3 border-t border-[#10171D]/20\" data-kid=\"1-1-3\" data-name=\"sidebar sources section\">\n<div class=\"text-[11px] font-medium text-[#10171D]/60\" data-kid=\"1-1-3-1\" data-name=\"Sources section heading\">Sources</div>\n<div class=\"mt-1.5 flex flex-col gap-1\" data-kid=\"1-1-3-2\" data-name=\"sources file list\">\n<div class=\"flex items-center gap-1.5 text-[11px] leading-4 text-[#10171D]/80\" data-kid=\"1-1-3-2-1\" data-name=\"CVS data source link row\">\n<i class=\"ph ph-table text-[12px] leading-none text-[#10171D]/40\" data-kid=\"1-1-3-2-1-1\" data-name=\"table icon\"></i>\n<span data-kid=\"1-1-3-2-1-2\" data-name=\"kpi_by_regime.csv source file name\">results/kpi_by_regime.csv</span>\n</div>\n<div class=\"flex items-center gap-1.5 text-[11px] leading-4 text-[#10171D]/80\" data-kid=\"1-1-3-2-2\" data-name=\"environment source file row\">\n<i class=\"ph ph-file-code text-[12px] leading-none text-[#10171D]/40\" data-kid=\"1-1-3-2-2-1\" data-name=\"file code icon\"></i>\n<span data-kid=\"1-1-3-2-2-2\" data-name=\"env.py source file name\">spectrum/env.py</span>\n</div>\n</div>\n</div>\n<div class=\"mt-auto pt-3 border-t border-[#10171D]/20\" data-kid=\"1-1-4\" data-name=\"sidebar model artifacts section\">\n<div class=\"text-[11px] font-medium text-[#10171D]/60\" data-kid=\"1-1-4-1\" data-name=\"Model artifacts section heading\">Model artifacts</div>\n<div class=\"mt-1.5 flex flex-col gap-1 text-[11px] leading-4\" data-kid=\"1-1-4-2\" data-name=\"model artifact status list\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-4-2-1\" data-name=\"policy.pt artifact status row\">\n<span class=\"text-[#10171D]/80\" data-kid=\"1-1-4-2-1-1\" data-name=\"policy.pt artifact name\">policy.pt</span>\n<span class=\"text-[#10171D]/50\" data-kid=\"1-1-4-2-1-2\" data-name=\"policy.pt loaded status badge\">loaded</span>\n</div>\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-4-2-2\" data-name=\"predictor.pt artifact status row\">\n<span class=\"text-[#10171D]/80\" data-kid=\"1-1-4-2-2-1\" data-name=\"predictor.pt artifact name\">predictor.pt</span>\n<span class=\"text-[#10171D]/50\" data-kid=\"1-1-4-2-2-2\" data-name=\"predictor.pt loaded status badge\">loaded</span>\n</div>\n</div>\n</div>\n</aside>\n<!-- MAIN -->\n<div class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"1-2\" data-name=\"main content area\">\n<header class=\"h-[52px] shrink-0 px-4 flex items-center justify-between border-b border-[#10171D]/20 bg-[#EBE9E9]\" data-kid=\"1-2-1\" data-name=\"main content header bar\">\n<div class=\"text-[15px] font-semibold leading-none\" data-kid=\"1-2-1-1\" data-name=\"page current section title\">Live Simulation</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"band configuration summary\">\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-1\" data-name=\"band value pair\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-1-1\" data-name=\"band label\">band</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-1-2\" data-name=\"3.5 GHz band value\">3.5 GHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-2\" data-name=\"config summary divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-3\" data-name=\"carrier value pair\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-3-1\" data-name=\"carrier label\">carrier</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-3-2\" data-name=\"100 MHz carrier value\">100 MHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-4\" data-name=\"config summary divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-5\" data-name=\"SCS value pair\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-5-1\" data-name=\"SCS label\">SCS</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-5-2\" data-name=\"30 kHz SCS value\">30 kHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-6\" data-name=\"config summary divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-7\" data-name=\"RBG value pair\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-7-1\" data-name=\"RBG label\">RBG</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-7-2\" data-name=\"18 RBG count value\">18</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-8\" data-name=\"config summary divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-9\" data-name=\"slot value pair\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-9-1\" data-name=\"slot label\">slot</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-9-2\" data-name=\"0.5 ms slot value\">0.5 ms</span></span>\n</div>\n</header>\n<div class=\"flex-1 px-4 pt-3 pb-4 flex flex-col gap-3\" data-kid=\"1-2-2\" data-name=\"main content body\">\n<!-- CONFIGURATOR -->\n<section data-kid=\"1-2-2-1\" data-name=\"paired episode configuration section\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"configuration section header row\">\n<div class=\"text-[13px] font-semibold\" data-kid=\"1-2-2-1-1-1\" data-name=\"paired episode configuration title\">Paired episode configuration</div>\n<div class=\"text-[11px] text-[#10171D]/55\" data-kid=\"1-2-2-1-1-2\" data-name=\"configuration subtitle description\">same seed, traffic realisation and incumbent trajectory</div>\n</div>\n<div class=\"mt-2 grid grid-cols-[1fr_56px_1fr] items-stretch\" data-kid=\"1-2-2-1-2\" data-name=\"dual allocator configuration grid\">\n<div class=\"h-[132px] rounded-[14px] border border-[#10171D]/20 bg-white px-4 py-3\" data-kid=\"1-2-2-1-2-1\" data-name=\"baseline Proportional Fair allocator card\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"allocator A header row\">\n<div class=\"text-[15px] font-semibold leading-none\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"Proportional Fair allocator name\">Proportional Fair</div>\n<div class=\"text-[10.5px] text-[#10171D]/50\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"Allocator A tag\">Allocator A</div>\n</div>\n<div class=\"mt-3 grid grid-cols-[76px_1fr] gap-x-3 gap-y-[6px] text-[12px] leading-[16px]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"allocator A parameter grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"scheduler parameter label\">scheduler</span><span data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"Proportional Fair scheduler value\">Proportional Fair</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-2-1-2-1-2-3\" data-name=\"sensing parameter label\">sensing</span><span data-kid=\"1-2-2-1-2-1-2-4\" data-name=\"energy detector sensing value\">energy detector</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-2-1-2-1-2-5\" data-name=\"training parameter label\">training</span><span data-kid=\"1-2-2-1-2-1-2-6\" data-name=\"none training value\">none</span>\n</div>\n</div>\n<div class=\"flex flex-col items-center justify-center gap-2\" data-kid=\"1-2-2-1-2-2\" data-name=\"center divider between allocators\">\n<span class=\"h-[38px] w-px bg-[#10171D]/20\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"upper divider line\"></span>\n<i class=\"ph ph-arrows-left-right text-[13px] leading-none text-[#10171D]/50\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"left-right comparison arrow icon\"></i>\n<span class=\"h-[38px] w-px bg-[#10171D]/20\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"lower divider line\"></span>\n</div>\n<div class=\"h-[132px] rounded-[14px] border border-[#10171D]/45 bg-white px-4 py-3\" data-kid=\"1-2-2-1-2-3\" data-name=\"proposed NeuroSpectrum allocator card\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"allocator B header row\">\n<div class=\"text-[15px] font-semibold leading-none\" data-kid=\"1-2-2