      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css\");\n\n  .pk-serif { font-family: 'PT Serif', Georgia, 'Times New Roman', serif; }\n  .tnum {\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -0.012em;\n  }\n  .well { box-shadow: inset 0 1px 2px rgba(28,19,22,0.14), inset 0 0 0 1px rgba(28,19,22,0.09); }\n  .well-soft { box-shadow: inset 0 1px 2px rgba(28,19,22,0.07), inset 0 0 0 1px rgba(28,19,22,0.08); }\n</style>\n<div class=\"min-h-screen w-full bg-[#FFFDF6] text-[#1C1316] antialiased\" data-kid=\"1\" data-name=\"wireless spectrum allocation dashboard root\" style=\"font-family:'PT Serif',Georgia,serif;\">\n<!-- ── Persistent sidebar ─────────────────────────────────────── -->\n<aside class=\"fixed left-0 top-0 flex h-full w-[184px] flex-col border-r border-[rgba(28,19,22,0.16)] bg-[#FFFDF6] px-4 py-5\" data-kid=\"1-1\" data-name=\"persistent sidebar navigation\">\n<div class=\"text-[14.5px] font-bold leading-[1.3] tracking-[-0.005em]\" data-kid=\"1-1-1\" data-name=\"sidebar brand title\">\n      Spectrum Allocation<br data-kid=\"1-1-1-1\" data-name=\"line break separator\"/>Benchmark\n    </div>\n<nav class=\"mt-9 flex flex-col\" data-kid=\"1-1-2\" data-name=\"sidebar navigation links\">\n<a class=\"flex h-9 items-center text-[13.5px] text-[#1C1316]/60\" data-kid=\"1-1-2-1\" data-name=\"nav link Overview\" href=\"#\">Overview</a>\n<a class=\"flex h-9 items-center\" data-kid=\"1-1-2-2\" data-name=\"nav link Live Simulation\" href=\"#\">\n<span class=\"inline-block border-b-2 border-[#BEF5EF] pb-[3px] text-[13.5px] font-semibold text-[#1C1316]\" data-kid=\"1-1-2-2-1\" data-name=\"active nav item label\">Live Simulation</span>\n</a>\n<a class=\"flex h-9 items-center text-[13.5px] text-[#1C1316]/60\" data-kid=\"1-1-2-3\" data-name=\"nav link Predictor\" href=\"#\">Predictor</a>\n<a class=\"flex h-9 items-center text-[13.5px] text-[#1C1316]/60\" data-kid=\"1-1-2-4\" data-name=\"nav link Ablation\" href=\"#\">Ablation</a>\n<a class=\"flex h-9 items-center text-[13.5px] text-[#1C1316]/60\" data-kid=\"1-1-2-5\" data-name=\"nav link Methodology\" href=\"#\">Methodology</a>\n</nav>\n<div class=\"mt-auto\" data-kid=\"1-1-3\" data-name=\"sidebar footer spacer container\">\n<div class=\"mb-3 flex items-baseline gap-1.5 border-t border-[rgba(28,19,22,0.12)] pt-3 text-[10.5px] text-[#1C1316]/50\" data-kid=\"1-1-3-1\" data-name=\"resource summary stats row\">\n<span class=\"tnum font-medium text-[#1C1316]/70\" data-kid=\"1-1-3-1-1\" data-name=\"episode count number\">288</span><span data-kid=\"1-1-3-1-2\" data-name=\"episodes unit label\">episodes</span>\n<span class=\"ml-auto tnum font-medium text-[#1C1316]/70\" data-kid=\"1-1-3-1-3\" data-name=\"allocator count number\">9</span><span data-kid=\"1-1-3-1-4\" data-name=\"allocators unit label\">allocators</span>\n</div>\n<button class=\"well-soft flex h-8 w-full items-center justify-center gap-1 whitespace-nowrap rounded-[12px] px-1 text-[10.5px] text-[#1C1316]/75\" data-kid=\"1-1-3-2\" data-name=\"download statistics button\">\n<i class=\"ri-download-2-line text-[11px]\" data-kid=\"1-1-3-2-1\" data-name=\"download icon\"></i>\n        Download paired statistics\n      </button>\n</div>\n</aside>\n<!-- ── Main column ────────────────────────────────────────────── -->\n<main class=\"ml-[184px] px-6\" data-kid=\"1-2\" data-name=\"main content column\">\n<!-- App header -->\n<header class=\"flex h-14 items-center justify-between border-b border-[rgba(28,19,22,0.14)]\" data-kid=\"1-2-1\" data-name=\"app header bar\">\n<div class=\"text-[13px] font-bold tracking-[-0.005em]\" data-kid=\"1-2-1-1\" data-name=\"current page title\">Live Simulation</div>\n<div class=\"tnum flex items-center gap-2 text-[10.5px] text-[#1C1316]/55\" data-kid=\"1-2-1-2\" data-name=\"carrier specifications display\">\n<i class=\"ri-signal-tower-line text-[12px]\" data-kid=\"1-2-1-2-1\" data-name=\"signal tower icon\"></i>\n<span data-kid=\"1-2-1-2-2\" data-name=\"carrier frequency spec text\">3.5 GHz carrier · 100 MHz · 18 RBG · 0.5 ms slot</span>\n</div>\n</header>\n<!-- Persistent scope bar -->\n<div class=\"flex h-14 items-center gap-5 border-b border-[rgba(28,19,22,0.14)]\" data-kid=\"1-2-2\" data-name=\"simulation scope control bar\">\n<div class=\"text-[10.5px] text-[#1C1316]/55\" data-kid=\"1-2-2-1\" data-name=\"congestion regime label\">Congestion regime</div>\n<div class=\"well-soft flex items-center gap-0.5 rounded-[12px] bg-[#FFFDF6] p-[3px]\" data-kid=\"1-2-2-2\" data-name=\"regime selector segmented control\">\n<span class=\"flex h-[26px] items-center rounded-[9px] px-2.5 text-[12px] text-[#1C1316]/60\" data-kid=\"1-2-2-2-1\" data-name=\"regime option Low (inactive)\">Low</span>\n<span class=\"flex h-[26px] items-center rounded-[9px] px-2.5 text-[12px] text-[#1C1316]/60\" data-kid=\"1-2-2-2-2\" data-name=\"regime option Medium (inactive)\">Medium</span>\n<span class=\"well flex h-[26px] items-center rounded-[9px] bg-white px-2.5 text-[12px] font-semibold text-[#1C1316]\" data-kid=\"1-2-2-2-3\" data-name=\"regime option High (selected)\">High</span>\n<span class=\"flex h-[26px] items-center rounded-[9px] px-2.5 text-[12px] text-[#1C1316]/60\" data-kid=\"1-2-2-2-4\" data-name=\"regime option Peak (inactive)\">Peak</span>\n</div>\n<div class=\"flex items-center gap-4 border-l border-[rgba(28,19,22,0.12)] pl-5 text-[11px] text-[#1C1316]/60\" data-kid=\"1-2-2-3\" data-name=\"simulation parameters group\">\n<span data-kid=\"1-2-2-3-1\" data-name=\"active user equipment count display\"><span class=\"tnum font-medium text-[#1C1316]\" data-kid=\"1-2-2-3-1-1\" data-name=\"UE count number\">55</span> UEs</span>\n<span data-kid=\"1-2-2-3-2\" data-name=\"load multiplier display\">load <span class=\"tnum font-med