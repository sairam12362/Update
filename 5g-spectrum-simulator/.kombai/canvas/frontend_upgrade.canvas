      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;500;600;700&display=swap');\n  body { background: #1D1314; font-family: 'Encode Sans', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }\n  .tnum { font-variant-numeric: tabular-nums; font-feature-settings: \"tnum\" 1; }\n</style>\n<link data-kid=\"1\" data-name=\"tabler icons webfont stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"flex min-h-screen items-stretch\" data-kid=\"2\" data-name=\"page layout container\">\n<aside class=\"w-[208px] shrink-0 flex flex-col px-4 py-5 border-r border-[#FFBF00]/15\" data-kid=\"2-1\" data-name=\"spectral dashboard sidebar\">\n<div class=\"pb-4 border-b border-[#FFBF00]/15\" data-dynamic=\"true\" data-kid=\"2-1-1\" data-name=\"sidebar header with project title\" data-reason=\"false\">\n<div class=\"text-[13px] font-semibold leading-[1.35] text-[#FFBF00]\" data-kid=\"2-1-1-1\" data-name=\"project title text\">Spectrum Allocation Benchmark</div>\n<div class=\"mt-3 flex items-center gap-2\" data-kid=\"2-1-1-2\" data-name=\"status indicator row\">\n<span class=\"w-1.5 h-1.5 bg-[#32936F]\" data-kid=\"2-1-1-2-1\" data-name=\"connected status dot\"></span>\n<span class=\"text-[11px] tnum text-[#FFBF00]/60\" data-kid=\"2-1-1-2-2\" data-name=\"status label text\">policy.pt loaded</span>\n</div>\n</div>\n<nav class=\"mt-4 flex flex-col\" data-kid=\"2-1-2\" data-name=\"sidebar main navigation\">\n<a class=\"h-9 flex items-center px-3 text-[13px] font-medium bg-[#2274A5] text-white\" data-kid=\"2-1-2-1\" data-name=\"active navigation link (Overview)\">Overview</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-2\" data-name=\"navigation link (Live Simulation)\">Live Simulation</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-3\" data-name=\"navigation link (Predictor)\">Predictor</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-4\" data-name=\"navigation link (Ablation)\">Ablation</a>\n<a class=\"h-9 flex items-center px-3 text-[13px] text-[#FFBF00]/60\" data-kid=\"2-1-2-5\" data-name=\"navigation link (Methodology)\">Methodology</a>\n</nav>\n<div class=\"mt-auto pt-4 border-t border-[#FFBF00]/15\" data-kid=\"2-1-3\" data-name=\"sidebar footer source list\">\n<div class=\"text-[11px] text-[#FFBF00]/60\" data-kid=\"2-1-3-1\" data-name=\"figure sources section label\">Figure sources</div>\n<div class=\"mt-2 text-[11px] tnum leading-[1.7] text-[#FFBF00]/70\" data-kid=\"2-1-3-2\" data-name=\"source file list container\">\n<div data-kid=\"2-1-3-2-1\" data-name=\"source file path (headline.csv)\">results/headline.csv</div>\n<div data-kid=\"2-1-3-2-2\" data-name=\"source file path (kpi_by_regime.csv)\">results/kpi_by_regime.csv</div>\n</div>\n</div>\n</aside>\n<main class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"2-2\" data-name=\"main content area\">\n<div class=\"h-14 shrink-0 flex items-center justify-between gap-6 px-5 border-b border-[#FFBF00]/15\" data-kid=\"2-2-1\" data-name=\"top toolbar header\">\n<div class=\"text-[13px] font-semibold text-[#FFBF00]\" data-kid=\"2-2-1-1\" data-name=\"toolbar page title\">Intelligent Spectrum Allocation</div>\n<div class=\"flex items-center gap-3 text-[11px]\" data-kid=\"2-2-1-2\" data-name=\"parameter values summary row\">\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-1\" data-name=\"carrier parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-1-1\" data-name=\"carrier parameter label\">Carrier</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-1-2\" data-name=\"carrier parameter value\">3.5 GHz</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-2\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-3\" data-name=\"bandwidth parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-3-1\" data-name=\"bandwidth parameter label\">Bandwidth</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-3-2\" data-name=\"bandwidth parameter value\">100 MHz</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-4\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-5\" data-name=\"RBG parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-5-1\" data-name=\"RBG parameter label\">RBG</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-5-2\" data-name=\"RBG parameter value\">18</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-1-2-6\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-1-2-7\" data-name=\"slot parameter display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-1-2-7-1\" data-name=\"slot parameter label\">Slot</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-1-2-7-2\" data-name=\"slot parameter value\">0.5 ms</span></div>\n</div>\n</div>\n<div class=\"h-12 shrink-0 flex items-center gap-4 px-5 border-b border-[#FFBF00]/15\" data-kid=\"2-2-2\" data-name=\"filter and range toolbar\">\n<div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1\" data-name=\"regime filter label with icon\">\n<span class=\"text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-2-1-1\" data-name=\"filter label icon container\"><i class=\"ti ti-filter\" data-kid=\"2-2-2-1-1-1\" data-name=\"filter funnel icon\"></i></span>\n<span class=\"text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-2-1-2\" data-name=\"regime filter label text\">Regime</span>\n</div>\n<div class=\"flex border border-[#FFBF00]/20\" data-kid=\"2-2-2-2\" data-name=\"regime filter segmented button group\">\n<button class=\"h-9 px-3 text-[12px] font-medium text-[#FFBF00]\" data-kid=\"2-2-2-2-1\" data-name=\"active regime filter button (All regimes)\" style=\"background:#241819; box-shadow: inset 0 0 0 1px rgba(255,191,0,0.35);\">All regimes</button>\n<button class=\"h-9 px-3 text-[12px] text-[#FFBF00]/60 border-l border-[#FFBF00]/15\" data-kid=\"2-2-2-2-2\" data-name=\"regime filter button (Low)\">Low</button>\n<button class=\"h-9 px-3 text-[12px] text-[#FFBF00]/60 border-l border-[#FFBF00]/15\" data-kid=\"2-2-2-2-3\" data-name=\"regime filter button (Medium)\">Medium</button>\n<button class=\"h-9 px-3 text-[12px] text-[#FFBF00]/60 border-l border-[#FFBF00]/15\" data-kid=\"2-2-2-2-4\" data-name=\"regime filter button (High)\">High</button>\n<button class=\"h-9 px-3 text-[12px] text-[#FFBF00]/60 border-l border-[#FFBF00]/15\" data-kid=\"2-2-2-2-5\" data-name=\"regime filter button (Peak)\">Peak</button>\n</div>\n<div class=\"ml-auto flex items-center gap-4 text-[11px]\" data-kid=\"2-2-2-3\" data-name=\"range values summary row\">\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-2-3-1\" data-name=\"UEs range display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-2-3-1-1\" data-name=\"UEs range label\">UEs</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-2-3-1-2\" data-name=\"UEs range value\">20–80</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-3-2\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-2-3-3\" data-name=\"Load range display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-2-3-3-1\" data-name=\"Load range label\">Load</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-2-3-3-2\" data-name=\"Load range value\">×0.55–2.30</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-3-4\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-2-3-5\" data-name=\"Incumbent duty range display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-2-3-5-1\" data-name=\"Incumbent duty range label\">Incumbent duty</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-2-3-5-2\" data-name=\"Incumbent duty range value\">12–46%</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-3-6\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-2-3-7\" data-name=\"seeds range display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-2-3-7-1\" data-name=\"seeds range label\">Seeds</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-2-3-7-2\" data-name=\"seeds range value\">8</span></div>\n<span class=\"w-px h-3 bg-[#FFBF00]/20\" data-kid=\"2-2-2-3-8\" data-name=\"vertical parameter separator\"></span>\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"2-2-2-3-9\" data-name=\"slots range display pair\"><span class=\"text-[#FFBF00]/60\" data-kid=\"2-2-2-3-9-1\" data-name=\"slots range label\">Slots</span><span class=\"tnum text-[#FFBF00]/90\" data-kid=\"2-2-2-3-9-2\" data-name=\"slots range value\">1000</span></div>\n</div>\n</div>\n<div class=\"px-5 pt-4 pb-5 flex flex-col\" data-kid=\"2-2-3\" data-name=\"main content scrollable body\">\n<div class=\"min-h-[104px] grid grid-cols-[1.55fr_1fr]\" data-kid=\"2-2-3-1\" data-name=\"results summary summary grid\">\n<div class=\"pr-6 flex flex-col justify-start gap-2\" data-kid=\"2-2-3-1-1\" data-name=\"primary summary column\">\n<div class=\"text-[13px] leading-[1.55] text-[#FFBF00]/84 max-w-[680px]\" data-kid=\"2-2-3-1-1-1\" data-name=\"primary summary finding text\">Harmful interference to the incumbent falls 42–69% in every congestion regime, and wasted idle spectrum falls 68–84% at medium load and above. Paired Wilcoxon p &lt; 0.05 in each case.</div>\n<div class=\"text-[13px] font-semibold text-[#FFBF00]\" data-kid=\"2-2-3-1-1-2\" data-name=\"best allocator highlight text\">Strongest allocator overall: M-LWDF + learned sensing.</div>\n</div>\n<div class=\"pl-6 border-l border-[#FFBF00]/15 flex flex-col justify-start gap-2\" data-kid=\"2-2-3-1-2\" data-name=\"secondary summary column\">\n<div class=\"text-[13px] leading-[1.55] text-[#FFBF00]/84\" data-kid=\"2-2-3-1-2-1\" data-name=\"QoS finding text\">QoS satisfaction is not significantly better than the best classical scheduler in any congestion regime (p ≥ 0.05).</div>\n<div class=\"text-[13px] leading-[1.55] text-[#FFBF00]/84\" data-kid=\"2-2-3-1-2-2\" data-name=\"Goodput/fairness finding text\">Goodput, p99 delay and Jain fairness are lower than the best classical scheduler at high and peak load.</div>\n</div>\n</div>\n<section class=\"mt-4\" data-kid=\"2-2-3-2\" data-name=\"comparison table section\">\n<div class=\"h-10 flex items-center justify-between gap-6\" data-kid=\"2-2-3-2-1\" data-name=\"table section header row\">\n<h2 class=\"text-[15px] font-semibold text-[#FFBF00]/90\" data-kid=\"2-2-3-2-1-1\" data-name=\"table section headline\">Direction-adjusted change against best classical scheduler</h2>\n<div class=\"flex items-center gap-4 text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-1-2\" data-name=\"table legend bar\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"favourable legend item\"><span class=\"w-2 h-2 bg-[#32936F]\" data-kid=\"2-2-3-2-1-2-1-1\" data-name=\"favourable swatch square\"></span>Favourable</span>\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"unfavourable legend item\"><span class=\"w-2 h-2 bg-[#E83F6F]\" data-kid=\"2-2-3-2-1-2-2-1\" data-name=\"unfavourable swatch square\"></span>Unfavourable</span>\n<span class=\"tnum\" data-kid=\"2-2-3-2-1-2-3\" data-name=\"n.s. legend notation\">n.s. = paired Wilcoxon p ≥ 0.05</span>\n</div>\n</div>\n<div class=\"overflow-x-auto\" data-kid=\"2-2-3-2-2\" data-name=\"table horizontal scroll container\">\n<table class=\"w-full min-w-[1000px] table-fixed border-collapse\" data-kid=\"2-2-3-2-2-1\" data-name=\"KPI comparison table\">\n<colgroup data-kid=\"2-2-3-2-2-1-1\" data-name=\"table column width definitions\">\n<col data-kid=\"2-2-3-2-2-1-1-1\" data-name=\"column width for category\" style=\"width:8%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-2\" data-name=\"column width for metric\" style=\"width:23%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-3\" data-name=\"column width for Better direction\" style=\"width:6%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-4\" data-name=\"column width for low regime\" style=\"width:15.75%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-5\" data-name=\"column width for medium regime\" style=\"width:15.75%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-6\" data-name=\"column width for high regime\" style=\"width:15.75%\"/>\n<col data-kid=\"2-2-3-2-2-1-1-7\" data-name=\"column width for peak regime\" style=\"width:15.75%\"/>\n</colgroup>\n<thead data-kid=\"2-2-3-2-2-1-2\" data-name=\"table header row\">\n<tr class=\"h-8 border-y border-[#FFBF00]/20 text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"header row container\">\n<th data-kid=\"2-2-3-2-2-1-2-1-1\" data-name=\"empty category header cell\"></th>\n<th class=\"pl-3 text-left font-medium\" data-kid=\"2-2-3-2-2-1-2-1-2\" data-name=\"metric column header\">Metric</th>\n<th class=\"text-center font-medium\" data-kid=\"2-2-3-2-2-1-2-1-3\" data-name=\"better column header\">Better</th>\n<th class=\"pr-4 text-right font-medium leading-none\" data-kid=\"2-2-3-2-2-1-2-1-4\" data-name=\"low regime column header\">low<div class=\"mt-1 text-[10px] font-normal text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-2-1-4-1\" data-name=\"low regime UEs sub-header\">20 UEs</div></th>\n<th class=\"pr-4 text-right font-medium leading-none\" data-kid=\"2-2-3-2-2-1-2-1-5\" data-name=\"medium regime column header\">medium<div class=\"mt-1 text-[10px] font-normal text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-2-1-5-1\" data-name=\"medium regime UEs sub-header\">35 UEs</div></th>\n<th class=\"pr-4 text-right font-medium leading-none\" data-kid=\"2-2-3-2-2-1-2-1-6\" data-name=\"high regime column header\">high<div class=\"mt-1 text-[10px] font-normal text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-2-1-6-1\" data-name=\"high regime UEs sub-header\">55 UEs</div></th>\n<th class=\"pr-4 text-right font-medium leading-none\" data-kid=\"2-2-3-2-2-1-2-1-7\" data-name=\"peak regime column header\">peak<div class=\"mt-1 text-[10px] font-normal text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-2-1-7-1\" data-name=\"peak regime UEs sub-header\">80 UEs</div></th>\n</tr>\n</thead>\n<tbody class=\"text-[13px]\" data-kid=\"2-2-3-2-2-1-3\" data-name=\"table body rows\">\n<tr class=\"h-9 border-b border-[#FFBF00]/10\" data-kid=\"2-2-3-2-2-1-3-1\" data-name=\"QoS satisfaction data row\">\n<td class=\"align-top pr-3 pt-[11px] text-[15px] font-medium text-[#FFBF00]/55 border-r border-[#FFBF00]/15\" data-kid=\"2-2-3-2-2-1-3-1-1\" data-name=\"Service category row-span label\" rowspan=\"5\">Service</td>\n<td class=\"pl-3 text-[#FFBF00]/84\" data-kid=\"2-2-3-2-2-1-3-1-2\" data-name=\"QoS satisfaction metric label\">QoS satisfaction <span class=\"text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-2-1\" data-name=\"QoS satisfaction unit\">%</span></td>\n<td class=\"text-center\" data-kid=\"2-2-3-2-2-1-3-1-3\" data-name=\"QoS better-direction cell\"><span class=\"text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-3-1\" data-name=\"QoS better-direction icon wrapper\"><i aria-label=\"Higher is better\" class=\"ti ti-arrow-up\" data-kid=\"2-2-3-2-2-1-3-1-3-1-1\" data-name=\"higher-is-better arrow-up icon\" title=\"Higher is better\"></i></span></td>\n<td class=\"pr-4\" data-kid=\"2-2-3-2-2-1-3-1-4\" data-name=\"QoS low-regime value cell\"><div class=\"flex items-baseline justify-end gap-2\" data-kid=\"2-2-3-2-2-1-3-1-4-1\" data-name=\"QoS low-regime value pair\"><span class=\"tnum text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-4-1-1\" data-name=\"QoS low-regime delta value\">−1.9</span><span class=\"w-[30px] shrink-0 text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-4-1-2\" data-name=\"QoS low-regime n.s. marker\">n.s.</span></div></td>\n<td class=\"pr-4\" data-kid=\"2-2-3-2-2-1-3-1-5\" data-name=\"QoS medium-regime value cell\"><div class=\"flex items-baseline justify-end gap-2\" data-kid=\"2-2-3-2-2-1-3-1-5-1\" data-name=\"QoS medium-regime value pair\"><span class=\"tnum text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-5-1-1\" data-name=\"QoS medium-regime delta value\">−26.6</span><span class=\"w-[30px] shrink-0 text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-5-1-2\" data-name=\"QoS medium-regime n.s. marker\">n.s.</span></div></td>\n<td class=\"pr-4\" data-kid=\"2-2-3-2-2-1-3-1-6\" data-name=\"QoS high-regime value cell\"><div class=\"flex items-baseline justify-end gap-2\" data-kid=\"2-2-3-2-2-1-3-1-6-1\" data-name=\"QoS high-regime value pair\"><span class=\"tnum text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-6-1-1\" data-name=\"QoS high-regime delta value\">−3.3</span><span class=\"w-[30px] shrink-0 text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-6-1-2\" data-name=\"QoS high-regime n.s. marker\">n.s.</span></div></td>\n<td class=\"pr-4\" data-kid=\"2-2-3-2-2-1-3-1-7\" data-name=\"QoS peak-regime value cell\"><div class=\"flex items-baseline justify-end gap-2\" data-kid=\"2-2-3-2-2-1-3-1-7-1\" data-name=\"QoS peak-regime value pair\"><span class=\"tnum text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-7-1-1\" data-name=\"QoS peak-regime delta value\">+3.3</span><span class=\"w-[30px] shrink-0 text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-1-7-1-2\" data-name=\"QoS peak-regime n.s. marker\">n.s.</span></div></td>\n</tr>\n<tr class=\"h-9 border-b border-[#FFBF00]/10\" data-kid=\"2-2-3-2-2-1-3-2\" data-name=\"Goodput data row\">\n<td class=\"pl-3 text-[#FFBF00]/84\" data-kid=\"2-2-3-2-2-1-3-2-1\" data-name=\"Goodput metric label\">Goodput <span class=\"text-[11px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2-1-3-2-1-1\" data-name=\"Goodput unit\">Mb/s</span></td>\n<td class=\"text-center\" dat