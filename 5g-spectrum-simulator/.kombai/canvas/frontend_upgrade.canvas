t-[#FFBF00]/70\" data-kid=\"2-2-3-1-2-5-7-2\" data-name=\"Vacancy A value\">11.431</div><div class=\"text-right tnum text-[#FFBF00]\" data-kid=\"2-2-3-1-2-5-7-3\" data-name=\"Vacancy B value\">1.958</div><div class=\"flex items-center justify-end gap-1 tnum text-[#FFBF00]\" data-kid=\"2-2-3-1-2-5-7-4\" data-name=\"Vacancy change value\">+82.9<i class=\"ti ti-arrow-up text-[10px] text-[#FFBF00]/50\" data-kid=\"2-2-3-1-2-5-7-4-1\" data-name=\"better direction arrow icon\"></i></div></div>\n<div class=\"grid grid-cols-[1fr_82px_82px_60px] h-[30px] items-center border-b border-[#FFBF00]/10 text-[11px]\" data-kid=\"2-2-3-1-2-5-8\" data-name=\"Jain fairness row\"><div class=\"text-[#FFBF00]/84\" data-kid=\"2-2-3-1-2-5-8-1\" data-name=\"Jain fairness label\">Jain fairness</div><div class=\"text-right tnum text-[#FFBF00]/70\" data-kid=\"2-2-3-1-2-5-8-2\" data-name=\"Jain A value\">0.8389</div><div class=\"text-right tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-5-8-3\" data-name=\"Jain B value\">0.7976</div><div class=\"flex items-center justify-end gap-1 tnum text-[#FFBF00]/70\" data-kid=\"2-2-3-1-2-5-8-4\" data-name=\"Jain change value\">−4.9<i class=\"ti ti-arrow-down text-[10px] text-[#FFBF00]/50\" data-kid=\"2-2-3-1-2-5-8-4-1\" data-name=\"worse direction arrow icon\"></i></div></div>\n<div class=\"grid grid-cols-[1fr_82px_82px_60px] h-[30px] items-center border-b border-[#FFBF00]/15 text-[11px]\" data-kid=\"2-2-3-1-2-5-9\" data-name=\"Allocation waste row\"><div class=\"text-[#FFBF00]/84\" data-kid=\"2-2-3-1-2-5-9-1\" data-name=\"Allocation waste label\">Allocation waste <span class=\"text-[10px] text-[#FFBF00]/50\" data-kid=\"2-2-3-1-2-5-9-1-1\" data-name=\"waste unit\">%</span></div><div class=\"text-right tnum text-[#FFBF00]/70\" data-kid=\"2-2-3-1-2-5-9-2\" data-name=\"Waste A value\">8.031</div><div class=\"text-right tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-5-9-3\" data-name=\"Waste B value\">3.088</div><div class=\"flex items-center justify-end gap-1 tnum text-[#FFBF00]/70\" data-kid=\"2-2-3-1-2-5-9-4\" data-name=\"Waste change value\">+61.5<i class=\"ti ti-arrow-up text-[10px] text-[#FFBF00]/50\" data-kid=\"2-2-3-1-2-5-9-4-1\" data-name=\"better direction arrow icon\"></i></div></div>\n</div>\n<div class=\"h-9 mt-3 flex items-center gap-3\" data-kid=\"2-2-3-1-2-6\" data-name=\"run actions row\">\n<button class=\"h-9 px-3 flex items-center gap-2 border border-[#FFBF00]/20 text-[11px] text-[#FFBF00]/80\" data-kid=\"2-2-3-1-2-6-1\" data-name=\"export episode call-to-action\"><i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-3-1-2-6-1-1\" data-name=\"download icon\"></i><span data-kid=\"2-2-3-1-2-6-1-2\" data-name=\"export label\">Export episode</span></button>\n<span class=\"tnum text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-1-2-6-2\" data-name=\"export field note\">results/kpi_by_regime.csv</span>\n</div>\n<div class=\"h-10 mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-3-1-2-7\" data-name=\"channel and sensing section header\">\n<h2 class=\"text-[15px] font-semibold text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-7-1\" data-name=\"channel and sensing headline\">Channel and sensing</h2>\n<span class=\"tnum text-[10px] text-[#FFBF00]/60\" data-kid=\"2-2-3-1-2-7-2\" data-name=\"parity field note\">identical for A and B</span>\n</div>\n<div class=\"grid grid-cols-4 border-l border-t border-[#FFBF00]/15\" data-kid=\"2-2-3-1-2-8\" data-name=\"channel and sensing field matrix\">\n<div class=\"h-[52px] border-r border-b border-[#FFBF00]/15 px-2.5 pt-2\" data-kid=\"2-2-3-1-2-8-1\" data-name=\"detection probability field\"><div class=\"text-[10px] text-[#FFBF00]/55\" data-kid=\"2-2-3-1-2-8-1-1\" data-name=\"Pd field label\">P<sub data-kid=\"2-2-3-1-2-8-1-1-1\" data-name=\"detection subscript\">d</sub></div><div class=\"mt-1 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-8-1-2\" data-name=\"Pd field value\">0.85</div></div>\n<div class=\"h-[52px] border-r border-b border-[#FFBF00]/15 px-2.5 pt-2\" data-kid=\"2-2-3-1-2-8-2\" data-name=\"false alarm probability field\"><div class=\"text-[10px] text-[#FFBF00]/55\" data-kid=\"2-2-3-1-2-8-2-1\" data-name=\"Pfa field label\">P<sub data-kid=\"2-2-3-1-2-8-2-1-1\" data-name=\"false alarm subscript\">fa</sub></div><div class=\"mt-1 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-8-2-2\" data-name=\"Pfa field value\">0.12</div></div>\n<div class=\"h-[52px] border-r border-b border-[#FFBF00]/15 px-2.5 pt-2\" data-kid=\"2-2-3-1-2-8-3\" data-name=\"CQI report age field\"><div class=\"text-[10px] text-[#FFBF00]/55\" data-kid=\"2-2-3-1-2-8-3-1\" data-name=\"CQI field label\">CQI age</div><div class=\"mt-1 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-8-3-2\" data-name=\"CQI field value\">2 slots</div></div>\n<div class=\"h-[52px] border-r border-b border-[#FFBF00]/15 px-2.5 pt-2\" data-kid=\"2-2-3-1-2-8-4\" data-name=\"HARQ retransmission field\"><div class=\"text-[10px] text-[#FFBF00]/55\" data-kid=\"2-2-3-1-2-8-4-1\" data-name=\"HARQ field label\">HARQ retx</div><div class=\"mt-1 text-[12px] tnum text-[#FFBF00]/90\" data-kid=\"2-2-3-1-2-8-4-2\" data-name=\"HARQ field value\">3</div></div>\n</div>\n</div>\n</div>\n<div class=\"h-11 mt-3 flex items-end gap-1 border-b border-[#FFBF00]/15\" data-kid=\"2-2-3-2\" data-name=\"result view tab bar\">\n<button class=\"h-9 px-4 text-[12px] font-medium text-[#FFBF00] border border-[#FFBF00]/20 border-b-0\" data-kid=\"2-2-3-2-1\" data-name=\"active view tab (Occupancy)\" style=\"background:#241819\">Occupancy</button>\n<button class=\"h-9 px-4 text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-2\" data-name=\"view tab (Per-slot KPIs)\">Per-slot KPIs</button>\n<button class=\"h-9 px-4 text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-3\" data-name=\"result view tab (Radar)\">Radar</button>\n<button class=\"h-9 px-4 text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-4\" data-name=\"result view tab (3-D surface)\">3-D surface</button>\n<button class=\"h-9 px-4 text-[12px] text-[#FFBF00]/60\" data-kid=\"2-2-3-2-5\" data-name=\"result view tab (Episode summary)\">Episode summary</button>\n</div>\n</div>\n</main>\n</div>\n<script>\n(function () {\n  var COLS = 64, SUBBANDS = 6, RBG_PER_SB = 3;\n  function rnd(n) { var x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); }\n  var PINK = 'rgba(232,63,111,0.78)';\n  var AMBER = 'rgba(255,191,0,0.17)';\n  var DIM = 'rgba(255,191,0,0.035)';\n  function build(id, pinkInBurst, idleFree) {\n    var host = document.getElementById(id);\n    if (!host) return;\n    var frag = document.createDocumentFragment();\n    for (var rbg = 0; rbg < 18; rbg++) {\n      var sb = Math.floor(rbg / 3);\n      for (var c = 0; c < 64; c++) {\n        var burst = ((c + sb * 2) % 11) < 4;\n        var colour;\n        if (burst) {\n          var h = rnd(sb * 131 + c * 17 + 3);\n          colour = h < pinkInBurst ? PINK : DIM;\n        } else {\n          var g = rnd(rbg * 173 + c * 7 + 9);\n          colour = g < idleFree ? DIM : AMBER;\n        }\n        var cell = document.createElement('div');\n        cell.style.background = colour;\n        frag.appendChild(cell);\n      }\n    }\n    host.style.display = 'grid';\n    host.style.gridTemplateColumns = 'repeat(64, 1fr)';\n    host.style.gridAutoRows = '6px';\n    host.style.gap = '1px';\n    host.appendChild(frag);\n  }\n  build('wfA', 0.26, 0.11);\n  build('wfB', 0.09, 0.02);\n\n  var svg = document.getElementById('sery');\n  if (!svg) return;\n  var W = 650, H = 92, MAX = 240;\n  function y(v) { return H - (v / MAX) * H; }\n  function hash2(n) { var x = Math.sin(n * 78.233) * 43758.5453; return x - Math.floor(x); }\n  var A = [], B = [];\n  for (var i = 0; i < 64; i++) {\n    A.push(196 + 30 * Math.sin(i * 0.30) + 12 * Math.sin(i * 0.83 + 0.7) + 8 * (hash2(i) - 0.5) - (i > 46 ? (i - 46) * 0.9 : 0));\n    B.push(193 + 26 * Math.sin(i * 0.27 + 2.1) + 10 * Math.sin(i * 0.77 + 1.9) + 6 * (hash2(i + 99) - 0.5) - (i > 46 ? (i - 46) * 0.5 : 0));\n  }\n  function path(arr) {\n    var d = '';\n    for (var k = 0; k < arr.length; k++) {\n      var px = (k / (arr.length - 1)) * W;\n      d += (k === 0 ? 'M' : 'L') + px.toFixed(2) + ' ' + y(arr[k]).toFixed(2) + ' ';\n    }\n    return d;\n  }\n  var ns = 'http://www.w3.org/2000/svg';\n  [240, 160, 80, 0].forEach(function (tick) {\n    var line = document.createElementNS(ns, 'line');\n    line.setAttribute('x1', 0); line.setAttribute('x2', W);\n    line.setAttribute('y1', y(tick)); line.setAttribute('y2', y(tick));\n    line.setAttribute('stroke', 'rgba(255,191,0,0.10)');\n    line.setAttribute('stroke-width', '1');\n    svg.appendChild(line);\n  });\n  [[A, 'rgba(255,191,0,0.45)', '4 3'], [B, '#FFBF00', '0']].forEach(function (pair) {\n    var p = document.createElementNS(ns, 'path');\n    p.setAttribute('d', path(pair[0]));\n    p.setAttribute('fill', 'none');\n    p.setAttribute('stroke', pair[1]);\n    p.setAttribute('stroke-width', '1.5');\n    p.setAttribute('stroke-dasharray', pair[2]);\n    p.setAttribute('vector-effect', 'non-scaling-stroke');\n    svg.appendChild(p);\n  });\n})();\n</script>",
