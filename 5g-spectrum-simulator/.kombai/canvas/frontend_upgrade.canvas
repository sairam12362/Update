6 pr-[168px]\" data-kid=\"1-2-4-2-1-11-5\" data-name=\"allocation waste comparison bar container\"><div class=\"h-[3px] bg-[rgba(28,19,22,0.22)]\" data-kid=\"1-2-4-2-1-11-5-1\" data-name=\"Proportional Fair waste bar\" style=\"width:100%\"></div><div class=\"mt-[3px] h-[3px] bg-[#1C1316]\" data-kid=\"1-2-4-2-1-11-5-2\" data-name=\"NeuroSpectrum waste bar\" style=\"width:38.4%\"></div></div>\n</div>\n</div>\n<!-- Occupancy -->\n<div class=\"h-[372px] rounded-[18px] bg-white px-5 py-[14px]\" data-kid=\"1-2-4-2-2\" data-name=\"spectrum occupancy heatmap card\">\n<div class=\"flex h-[26px] items-baseline justify-between\" data-kid=\"1-2-4-2-2-1\" data-name=\"occupancy card header\">\n<div class=\"flex items-baseline gap-5\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"occupancy title group\">\n<h2 class=\"text-[17px] font-bold leading-none tracking-[-0.01em]\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"occupancy card title\">Spectrum occupancy</h2>\n<div class=\"tnum text-[10.5px] text-[#1C1316]/50\" data-kid=\"1-2-4-2-2-1-1-2\" data-name=\"occupancy dimensions subtitle\">18 RBG × 1000 slots</div>\n</div>\n<div class=\"flex items-center gap-4 text-[10px] text-[#1C1316]/55\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"occupancy legend\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-4-2-2-1-2-1\" data-name=\"idle legend item\"><span class=\"h-[6px] w-[14px] border border-[rgba(28,19,22,0.22)]\" data-kid=\"1-2-4-2-2-1-2-1-1\" data-name=\"idle legend swatch\"></span>idle</span>\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-4-2-2-1-2-2\" data-name=\"clean TX legend item\"><span class=\"h-[6px] w-[14px] bg-[rgba(28,19,22,0.22)]\" data-kid=\"1-2-4-2-2-1-2-2-1\" data-name=\"clean TX legend swatch\"></span>clean TX</span>\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-4-2-2-1-2-3\" data-name=\"collision legend item\"><span class=\"h-[6px] w-[14px] bg-[#1C1316]\" data-kid=\"1-2-4-2-2-1-2-3-1\" data-name=\"collision legend swatch\"></span>collision</span>\n</div>\n</div>\n<div class=\"mt-2\" data-kid=\"1-2-4-2-2-2\" data-name=\"Proportional Fair occupancy group\">\n<div class=\"flex items-baseline justify-between text-[11px]\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"Proportional Fair occupancy label row\">\n<span class=\"text-[#1C1316]/70\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"Proportional Fair allocator name\">Proportional Fair</span>\n<span class=\"tnum text-[10.5px] text-[#1C1316]/50\" data-kid=\"1-2-4-2-2-2-1-2\" data-name=\"Proportional Fair occupancy stats\">collisions 7.115% · wasted vacancy 11.431%</span>\n</div>\n<div class=\"mt-1\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"Proportional Fair occupancy heatmap\" data-reason=\"SVG chart injected by script with rects generated from seeded RNG\" id=\"occ-a\"></div>\n</div>\n<div class=\"mt-2\" data-kid=\"1-2-4-2-2-3\" data-name=\"NeuroSpectrum occupancy group\">\n<div class=\"flex items-baseline justify-between text-[11px]\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"NeuroSpectrum occupancy label row\">\n<span class=\"text-[#1C1316]/70\" data-kid=\"1-2-4-2-2-3-1-1\" data-name=\"NeuroSpectrum allocator name\">NeuroSpectrum (proposed)</span>\n<span class=\"tnum text-[10.5px] text-[#1C1316]/50\" data-kid=\"1-2-4-2-2-3-1-2\" data-name=\"NeuroSpectrum occupancy stats\">collisions 5.304% · wasted vacancy 1.958%</span>\n</div>\n<div class=\"mt-1\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"NeuroSpectrum occupancy heatmap\" data-reason=\"SVG chart injected by script with rects generated from seeded RNG\" id=\"occ-b\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Provenance -->\n<div class=\"mt-4 flex h-10 items-center justify-between border-t border-[rgba(28,19,22,0.12)] text-[10.5px] text-[#1C1316]/50\" data-kid=\"1-2-5\" data-name=\"provenance footer bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-5-1\" data-name=\"provenance source info\">\n<i class=\"ri-file-list-3-line text-[12px]\" data-kid=\"1-2-5-1-1\" data-name=\"file list icon\"></i>\n<span class=\"tnum\" data-kid=\"1-2-5-1-2\" data-name=\"source file and parameters text\">results/kpi_by_regime.csv · episode 1000 slots · seed 1000 · regime high</span>\n</div>\n<div class=\"flex items-center gap-5\" data-kid=\"1-2-5-2\" data-name=\"nav action links group\">\n<a class=\"inline-flex items-center gap-1 text-[#1C1316]/70\" data-kid=\"1-2-5-2-1\" data-name=\"per-slot KPIs link\" href=\"#\">Per-slot KPIs <i class=\"ri-arrow-right-s-line text-[13px]\" data-kid=\"1-2-5-2-1-1\" data-name=\"right arrow icon\"></i></a>\n<a class=\"inline-flex items-center gap-1 text-[#1C1316]/70\" data-kid=\"1-2-5-2-2\" data-name=\"radar link\" href=\"#\">Radar <i class=\"ri-arrow-right-s-line text-[13px]\" data-kid=\"1-2-5-2-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</main>\n</div>\n<script>\n(function () {\n  var NS = 'http://www.w3.org/2000/svg';\n  var ROWS = 18, ROW_H = 6.2, VW = 908, GUT = 30, RPAD = 8, PAD_T = 2;\n  var PLOT_W = VW - GUT - RPAD;\n  var PLOT_H = ROWS * ROW_H;\n  var H = PLOT_H + PAD_T + 20;\n\n  function mulberry32(a) {\n    return function () {\n      a |= 0; a = (a + 0x6D2B79F5) | 0;\n      var t = Math.imul(a ^ (a >>> 15), 1 | a);\n      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  function el(name, attrs) {\n    var n = document.createElementNS(NS, name);\n    for (var k in attrs) { n.setAttribute(k, attrs[k]); }\n    return n;\n  }\n\n  function draw(hostId, mode, seed) {\n    var host = document.getElementById(hostId);\n    if (!host) return;\n    var svg = el('svg', { viewBox: '0 0 ' + VW + ' ' + H, width: '100%', height: H, role: 'img' });\n    svg.style.display = 'block';\n    svg.setAttribute('aria-label', mode === 'A'\n      ? 'Proportional Fair occupancy over 18 resource block groups and 1000 slots, with collision and idle blocks'\n      : 'NeuroSpectrum proposed occupancy over 18 resource block groups and 1000 slots, with collisions and little idle');\n\n    // row rules\n    for (var r = 0; r <= ROWS; r++) {\n      var y = PAD_T + r * ROW_H;\n      var subbandEdge = (ROWS - r) % 3 === 0;\n      svg.appendChild(el('line', {\n        x1: GUT, x2: GUT + PLOT_W, y1: y, y2: y,\n        stroke: subbandEdge ? 'rgba(28,19,22,0.30)' : 'rgba(28,19,22,0.10)',\n        'stroke-width': 1\n      }));\n    }\n\n    // occupancy blocks — one detector per subband, so the three RBG rows of a\n    // subband share the same mute/collision decision across a burst\n    for (var s = 0; s < 6; s++) {\n      var rndS = mulberry32(seed + s * 104729);\n      var segs = [], t0 = 0;\n      while (t0 < 1000) {\n        var occSeg = ((t0 + s * 18) % 124) < 42;\n        var t1 = t0 + 1;\n        while (t1 < 1000 && ((((t1 + s * 18) % 124) < 42) === occSeg)) { t1++; }\n        var base;\n        if (occSeg) {\n          base = rndS() < (mode === 'A' ? 0.15 : 0.035) ? 2 : 0;\n        } else {\n          base = rndS() < (mode === 'A' ? 0.12 : 0.035) ? 0 : 1;\n        }\n        segs.push([t0, t1, base]);\n        t0 = t1;\n      }\n\n      for (var k = 0; k < 3; k++) {\n        var row = ROWS - 1 - (s * 3 + k);\n        var rndRow = mulberry32(seed + row * 7919);\n        for (var i = 0; i < segs.length; i++) {\n          var a = segs[i][0], b = segs[i][1], state = segs[i][2];\n          if (state === 1 && rndRow() > (mode === 'A' ? 0.90 : 0.975)) { state = 0; }\n          if (state === 0) continue;\n          var x = GUT + (a / 1000) * PLOT_W;\n          var w = Math.max(0.7, ((b - a) / 1000) * PLOT_W);\n          svg.appendChild(el('rect', {\n            x: x.toFixed(2), y: (PAD_T + row * ROW_H + 0.9).toFixed(2),\n            width: w.toFixed(2), height: (ROW_H - 1.8).toFixed(2),\n            fill: state === 2 ? '#1C1316' : 'rgba(28,19,22,0.22)'\n          }));\n        }\n      }\n    }\n\n    // axis\n    var baseY = PAD_T + PLOT_H;\n    svg.appendChild(el('line', { x1: GUT, x2: GUT + PLOT_W, y1: baseY + 1, y2: baseY + 1, stroke: 'rgba(28,19,22,0.28)', 'stroke-width': 1 }));\n    for (var q = 0; q <= 1000; q += 200) {\n      var tx = GUT + (q / 1000) * PLOT_W;\n      svg.appendChild(el('line', { x1: tx, x2: tx, y1: baseY + 1, y2: baseY + 4, stroke: 'rgba(28,19,22,0.28)', 'stroke-width': 1 }));\n      var label = el('text', {\n        x: tx, y: baseY + 14, fill: 'rgba(28,19,22,0.55)', 'font-size': 9,\n        'font-family': 'Inter, system-ui, sans-serif', 'text-anchor': q === 0 ? 'start' : (q === 1000 ? 'end' : 'middle')\n      });\n      label.textContent = String(q);\n      svg.appendChild(label);\n    }\n\n    // row labels\n    var top = el('text', { x: GUT - 6, y: PAD_T + 5, fill: 'rgba(28,19,22,0.5)', 'font-size': 8.5, 'font-family': 'Inter, system-ui, sans-serif', 'text-anchor': 'end' });\n    top.textContent = '17';\n    svg.appendChild(top);\n    var bot = el('text', { x: GUT - 6, y: baseY - 1, fill: 'rgba(28,19,22,0.5)', 'font-size': 8.5, 'font-family': 'Inter, system-ui, sans-serif', 'text-anchor': 'end' });\n    bot.textContent = '0';\n    svg.appendChild(bot);\n\n    host.appendChild(svg);\n  }\n\n  draw('occ-a', 'A', 20261028);\n  draw('occ-b', 'B', 74031);\n})();\n</script>",
