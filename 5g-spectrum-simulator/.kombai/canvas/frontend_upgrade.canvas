      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n\n.speckle-bench{\n  background-color:#EBE9E9;\n  background-image:radial-gradient(rgba(16,23,29,0.055) 0.6px, transparent 0.7px),radial-gradient(rgba(16,23,29,0.035) 0.6px, transparent 0.7px);\n  background-size:5px 5px,13px 11px;\n  background-position:0 0, 3px 4px;\n}\n.speckle-amber{\n  background-color:#FCB07E;\n  background-image:radial-gradient(rgba(16,23,29,0.07) 0.6px, transparent 0.7px);\n  background-size:6px 6px;\n}\n.graphpaper{\n  background-color:#FFFFFF;\n  background-image:linear-gradient(to right, rgba(16,23,29,0.055) 1px, transparent 1px), linear-gradient(to bottom, rgba(16,23,29,0.055) 1px, transparent 1px);\n  background-size:16px 16px;\n  background-position:-1px -1px;\n}\n</style>\n<div class=\"min-h-screen w-full bg-[#EBE9E9] text-[#10171D] flex items-stretch\" data-kid=\"1\" data-name=\"page layout container (speckle themed dashboard shell)\" style=\"font-family:'Chivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;\">\n<!-- SIDEBAR -->\n<aside class=\"speckle-bench w-[224px] shrink-0 border-r border-[#10171D]/20 px-4 pt-4 pb-4 flex flex-col\" data-kid=\"1-1\" data-name=\"left sidebar with navigation and metadata\">\n<div class=\"pb-3 border-b border-[#10171D]/20\" data-kid=\"1-1-1\" data-name=\"sidebar brand section with title\">\n<div class=\"text-[13px] font-semibold leading-[1.25] tracking-[-0.01em]\" data-kid=\"1-1-1-1\" data-name=\"sidebar app title (Spectrum Allocation Benchmark)\">Spectrum Allocation<br data-kid=\"1-1-1-1-1\" data-name=\"line break in title\"/>Benchmark</div>\n</div>\n<nav class=\"mt-3 flex flex-col gap-px\" data-kid=\"1-1-2\" data-name=\"sidebar main navigation menu\">\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] bg-white px-2.5\" data-kid=\"1-1-2-1\" data-name=\"active nav item: Overview (highlighted with amber underline)\">\n<i class=\"ph ph-chart-line-up text-[14px] leading-none text-[#10171D]/65\" data-kid=\"1-1-2-1-1\" data-name=\"line chart icon\"></i>\n<span class=\"text-[13px] font-semibold leading-none border-b-2 border-[#FCB07E] pb-[3px]\" data-kid=\"1-1-2-1-2\" data-name=\"nav item label: Overview\">Overview</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-2\" data-name=\"nav item: Live Simulation\">\n<i class=\"ph ph-play-circle text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-2-1\" data-name=\"play circle icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-2-2\" data-name=\"nav item label: Live Simulation\">Live Simulation</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-3\" data-name=\"nav item: Predictor\">\n<i class=\"ph ph-waveform text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-3-1\" data-name=\"waveform icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-3-2\" data-name=\"nav item label: Predictor\">Predictor</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-4\" data-name=\"nav item: Ablation\">\n<i class=\"ph ph-sliders-horizontal text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-4-1\" data-name=\"sliders icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-4-2\" data-name=\"nav item label: Ablation\">Ablation</span>\n</div>\n<div class=\"flex h-[34px] items-center gap-2 rounded-[10px] px-2.5\" data-kid=\"1-1-2-5\" data-name=\"nav item: Methodology\">\n<i class=\"ph ph-book-open-text text-[14px] leading-none text-[#10171D]/45\" data-kid=\"1-1-2-5-1\" data-name=\"open book icon\"></i>\n<span class=\"text-[13px] leading-none text-[#10171D]/70\" data-kid=\"1-1-2-5-2\" data-name=\"nav item label: Methodology\">Methodology</span>\n</div>\n</nav>\n<div class=\"mt-4 pt-3 border-t border-[#10171D]/20\" data-kid=\"1-1-3\" data-name=\"sources section in sidebar\">\n<div class=\"text-[11px] font-medium text-[#10171D]/60\" data-kid=\"1-1-3-1\" data-name=\"section label: Sources\">Sources</div>\n<div class=\"mt-1.5 flex flex-col gap-1\" data-kid=\"1-1-3-2\" data-name=\"sources file list\">\n<div class=\"flex items-center gap-1.5 text-[11px] leading-4 text-[#10171D]/80\" data-kid=\"1-1-3-2-1\" data-name=\"source file row: results/ablation.csv\">\n<i class=\"ph ph-table text-[12px] leading-none text-[#10171D]/40\" data-kid=\"1-1-3-2-1-1\" data-name=\"table icon\"></i>\n<span data-kid=\"1-1-3-2-1-2\" data-name=\"source file name text\">results/ablation.csv</span>\n</div>\n<div class=\"flex items-center gap-1.5 text-[11px] leading-4 text-[#10171D]/80\" data-kid=\"1-1-3-2-2\" data-name=\"source file row: results/headline.csv\">\n<i class=\"ph ph-table text-[12px] leading-none text-[#10171D]/40\" data-kid=\"1-1-3-2-2-1\" data-name=\"table icon\"></i>\n<span data-kid=\"1-1-3-2-2-2\" data-name=\"source file name text\">results/headline.csv</span>\n</div>\n</div>\n</div>\n<div class=\"mt-auto pt-3 border-t border-[#10171D]/20\" data-kid=\"1-1-4\" data-name=\"model artifacts section in sidebar\">\n<div class=\"text-[11px] font-medium text-[#10171D]/60\" data-kid=\"1-1-4-1\" data-name=\"section label: Model artifacts\">Model artifacts</div>\n<div class=\"mt-1.5 flex flex-col gap-1 text-[11px] leading-4\" data-kid=\"1-1-4-2\" data-name=\"model artifact file list\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-4-2-1\" data-name=\"artifact row: policy.pt (loaded)\">\n<span class=\"text-[#10171D]/80\" data-kid=\"1-1-4-2-1-1\" data-name=\"artifact file name: policy.pt\">policy.pt</span>\n<span class=\"text-[#10171D]/50\" data-kid=\"1-1-4-2-1-2\" data-name=\"artifact status label: loaded\">loaded</span>\n</div>\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-4-2-2\" data-name=\"artifact row: predictor.pt (loaded)\">\n<span class=\"text-[#10171D]/80\" data-kid=\"1-1-4-2-2-1\" data-name=\"artifact file name: predictor.pt\">predictor.pt</span>\n<span class=\"text-[#10171D]/50\" data-kid=\"1-1-4-2-2-2\" data-name=\"artifact status label: loaded\">loaded</span>\n</div>\n</div>\n</div>\n</aside>\n<!-- MAIN -->\n<div class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"1-2\" data-name=\"main content column\">\n<!-- HEADER 52 -->\n<header class=\"h-[52px] shrink-0 px-4 flex items-center justify-between border-b border-[#10171D]/20 bg-[#EBE9E9]\" data-kid=\"1-2-1\" data-name=\"page header with title and configuration summary\">\n<div class=\"text-[15px] font-semibold leading-none\" data-kid=\"1-2-1-1\" data-name=\"header page title: Overview\">Overview</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"header configuration summary bar\">\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-1\" data-name=\"band configuration (3.5 GHz)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-1-1\" data-name=\"band label\">band</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-1-2\" data-name=\"band value: 3.5 GHz\">3.5 GHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-3\" data-name=\"carrier configuration (100 MHz)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-3-1\" data-name=\"carrier label\">carrier</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-3-2\" data-name=\"carrier value: 100 MHz\">100 MHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-4\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-5\" data-name=\"SCS configuration (30 kHz)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-5-1\" data-name=\"SCS label\">SCS</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-5-2\" data-name=\"SCS value: 30 kHz\">30 kHz</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-6\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-7\" data-name=\"RBG configuration (18)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-7-1\" data-name=\"RBG label\">RBG</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-7-2\" data-name=\"RBG value: 18\">18</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-1-2-8\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-1-2-9\" data-name=\"slot configuration (0.5 ms)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-1-2-9-1\" data-name=\"slot label\">slot</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-9-2\" data-name=\"slot value: 0.5 ms\">0.5 ms</span></span>\n</div>\n</header>\n<!-- FILTER BAR 52 -->\n<div class=\"speckle-amber h-[52px] shrink-0 px-4 flex items-center gap-4 border-b border-[#10171D]/25\" data-kid=\"1-2-2\" data-name=\"filter/parameter bar (amber theme)\">\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-1\" data-name=\"regime filter label with funnel icon\">\n<i class=\"ph ph-funnel text-[13px] leading-none text-[#10171D]/75\" data-kid=\"1-2-2-1-1\" data-name=\"funnel filter icon\"></i>\n<span class=\"text-[11px] font-semibold text-[#10171D]/75\" data-kid=\"1-2-2-1-2\" data-name=\"Regime label text\">Regime</span>\n</div>\n<div class=\"flex items-center gap-0.5 rounded-[14px] bg-[#10171D]/10 p-[3px]\" data-kid=\"1-2-2-2\" data-name=\"regime segmented control\">\n<div class=\"flex h-[26px] items-center rounded-[10px] bg-white px-2.5 text-[12px] font-semibold\" data-kid=\"1-2-2-2-1\" data-name=\"active regime pill: All regimes\">All regimes</div>\n<div class=\"flex h-[26px] items-center px-2.5 text-[12px] text-[#10171D]/75\" data-kid=\"1-2-2-2-2\" data-name=\"regime pill option: Low\">Low</div>\n<div class=\"flex h-[26px] items-center px-2.5 text-[12px] text-[#10171D]/75\" data-kid=\"1-2-2-2-3\" data-name=\"regime pill option: Medium\">Medium</div>\n<div class=\"flex h-[26px] items-center px-2.5 text-[12px] text-[#10171D]/75\" data-kid=\"1-2-2-2-4\" data-name=\"regime pill option: High\">High</div>\n<div class=\"flex h-[26px] items-center px-2.5 text-[12px] text-[#10171D]/75\" data-kid=\"1-2-2-2-5\" data-name=\"regime pill option: Peak\">Peak</div>\n</div>\n<span class=\"h-5 w-px bg-[#10171D]/25\" data-kid=\"1-2-2-3\" data-name=\"vertical divider\"></span>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-4\" data-name=\"parameter constraint summary bar\">\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-2-4-1\" data-name=\"UEs constraint (20-80)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-2-4-1-1\" data-name=\"UEs label\">UEs</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-2-4-1-2\" data-name=\"UEs value: 20-80\">20–80</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-2-4-2\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-2-4-3\" data-name=\"load constraint (x0.55-2.30)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-2-4-3-1\" data-name=\"load label\">load</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-2-4-3-2\" data-name=\"load value: x0.55-2.30\">×0.55–2.30</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-2-4-4\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-2-4-5\" data-name=\"duty constraint (12-46%)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-2-4-5-1\" data-name=\"duty label\">duty</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-2-4-5-2\" data-name=\"duty value: 12-46%\">12–46%</span></span>\n<span class=\"h-3 w-px bg-[#10171D]/25\" data-kid=\"1-2-2-4-6\" data-name=\"vertical divider\"></span>\n<span class=\"flex items-baseline gap-1.5\" data-kid=\"1-2-2-4-7\" data-name=\"seeds constraint (8 seeds x 1000 slots)\"><span class=\"text-[11px] text-[#10171D]/60\" data-kid=\"1-2-2-4-7-1\" data-name=\"seeds label: 8 seeds x\">8 seeds ×</span><span class=\"text-[12px] font-medium\" data-kid=\"1-2-2-4-7-2\" data-name=\"slots value: 1000 slots\">1000 slots</span></span>\n</div>\n</div>\n<!-- CONTENT -->\n<div class=\"flex-1 px-4 pt-3 pb-4 flex flex-col gap-3\" data-kid=\"1-2-3\" data-name=\"scrollable main content area\">\n<!-- FRAMING 92 -->\n<section class=\"h-[92px] grid grid-cols-[1fr_1px_1fr] items-start\" data-kid=\"1-2-3-1\" data-name=\"framing summary section (two-column findings)\">\n<div class=\"pr-5\" data-kid=\"1-2-3-1-1\" data-name=\"spectrum sharing findings column\">\n<div class=\"text-[11px] font-semibold text-[#10171D]/60\" data-kid=\"1-2-3-1-1-1\" data-name=\"column label: Spectrum sharing\">Spectrum sharing</div>\n<div class=\"mt-1.5 flex flex-col gap-1 text-[13px] leading-[18px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"findings list\">\n<div data-kid=\"1-2-3-1-1-2-1\" data-name=\"finding: interference reduction 42-69%\">Harmful interference to the incumbent <span class=\"font-semibold\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"highlighted stat: 42–69%\">42–69%</span> lower, every regime, <span class=\"font-medium\" data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"significance note: p &lt; 0.05\">p &lt; 0.05</span></div>\n<div data-kid=\"1-2-3-1-1-2-2\" data-name=\"finding: wasted vacancy 68-84% lower\">Wasted vacancy <span class=\"font-semibold\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"highlighted stat: 68–84%\">68–84%</span> lower at medium load and above, <span class=\"font-medium\" data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"significance note: p &lt; 0.05\">p &lt; 0.05</span></div>\n</div>\n</div>\n<div class=\"h-[76px] w-px bg-[#10171D]/20\" data-kid=\"1-2-3-1-2\" data-name=\"vertical divider between columns\"></div>\n<div class=\"pl-5\" data-kid=\"1-2-3-1-3\" data-name=\"service quality findings column\">\n<div class=\"text-[11px] font-semibold text-[#10171D]/60\" data-kid=\"1-2-3-1-3-1\" data-name=\"column label: Service quality\">Service quality</div>\n<div class=\"mt-1.5 flex flex-col gap-1 text-[13px] leading-[18px]\" data-kid=\"1-2-3-1-3-2\" data-name=\"findings list\">\n<div data-kid=\"1-2-3-1-3-2-1\" data-name=\"finding: QoS no significant difference\">QoS satisfaction: no significant difference in any regime, <span class=\"font-medium\" data-kid=\"1-2-3-1-3-2-1-1\" data-name=\"significance note: p ≥ 0.069\">p ≥ 0.069</span></div>\n<div data-kid=\"1-2-3-1-3-2-2\" data-name=\"finding: goodput/delay/fairness significantly worse\">Goodput, p99 delay and Jain fairness <span class=\"font-medium\" data-kid=\"1-2-3-1-3-2-2-1\" data-name=\"highlighted phrase: significantly worse\">significantly worse</span> at high and peak load</div>\n<div data-kid=\"1-2-3-1-3-2-3\" data-name=\"finding: strongest overall configuration\">Strongest overall configuration: <span class=\"font-semibold\" data-kid=\"1-2-3-1-3-2-3-1\" data-name=\"highlighted config: M-LWDF + learned sensing\">M-LWDF + learned sensing</span></div>\n</div>\n</div>\n</section>\n<!-- COMPONENT SUBSTITUTION MAP 206 -->\n<section class=\"graphpaper h-[206px] shrink-0 rounded-[14px] border border-[#10171D]/20 px-4 py-3\" data-kid=\"1-2-3-2\" data-name=\"component substitution map section (graph paper style)\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-3-2-1\" data-name=\"section header row\">\n<div class=\"text-[13px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-1\" data-name=\"section title: Component substitution\" data-reason=\"false\">Component substitution, 5 configurations</div>\n<div class=\"text-[11px] text-[#10171D]/55\" data-kid=\"1-2-3-2-1-2\" data-name=\"source label: results/ablation.csv\">results/ablation.csv</div>\n</div>\n<div class=\"mt-2 flex flex-col gap-2\" data-kid=\"1-2-3-2-2\" data-name=\"substitution routes container\">\n<!-- route A -->\n<div class=\"flex items-stretch\" data-kid=\"1-2-3-2-2-1\" data-name=\"route A: M-LWDF to learned sensing row\">\n<div class=\"w-[248px] shrink-0 rounded-[14px] border border-[#10171D]/25 bg-white px-3 py-2\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"source configuration card: M-LWDF\">\n<div class=\"text-[13px] font-medium leading-4\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"config name: M-LWDF\">M-LWDF</div>\n<div class=\"mt-1 grid grid-cols-[62px_1fr] gap-x-1.5 text-[11px] leading-[13px]\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"config spec grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-1-2-1\" data-name=\"spec label: scheduler\">scheduler</span><span data-kid=\"1-2-3-2-2-1-1-2-2\" data-name=\"spec value: M-LWDF\">M-LWDF</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-1-2-3\" data-name=\"spec label: sensing\">sensing</span><span data-kid=\"1-2-3-2-2-1-1-2-4\" data-name=\"spec value: energy detector\">energy detector</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-1-2-5\" data-name=\"spec label: training\">training</span><span data-kid=\"1-2-3-2-2-1-1-2-6\" data-name=\"spec value: none\">none</span>\n</div>\n</div>\n<div class=\"flex w-[128px] shrink-0 flex-col items-center justify-center px-2\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"route A transformation step (replace sensing front-end)\">\n<div class=\"text-center text-[10px] leading-[12px] text-[#10171D]/60\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"transformation description text\">replace sensing<br data-kid=\"1-2-3-2-2-1-2-1-1\" data-name=\"line break\"/>front-end</div>\n<div class=\"mt-1 flex w-full items-center gap-0\" data-kid=\"1-2-3-2-2-1-2-2\" data-name=\"connector arrow with line\">\n<span class=\"h-px flex-1 bg-[#10171D]/40\" data-kid=\"1-2-3-2-2-1-2-2-1\" data-name=\"connector line\"></span>\n<span class=\"text-[12px] leading-none text-[#10171D]/60\" data-kid=\"1-2-3-2-2-1-2-2-2\" data-name=\"arrow symbol\">→</span>\n</div>\n</div>\n<div class=\"w-[288px] shrink-0 rounded-[14px] border border-[#10171D]/45 bg-white px-3 py-2\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"target configuration card: M-LWDF + learned sensing (bolder border)\">\n<div class=\"text-[13px] font-semibold leading-4\" data-kid=\"1-2-3-2-2-1-3-1\" data-name=\"config name: M-LWDF + learned sensing\">M-LWDF + learned sensing</div>\n<div class=\"mt-1 grid grid-cols-[62px_1fr] gap-x-1.5 text-[11px] leading-[13px]\" data-kid=\"1-2-3-2-2-1-3-2\" data-name=\"config spec grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-3-2-1\" data-name=\"spec label: scheduler\">scheduler</span><span data-kid=\"1-2-3-2-2-1-3-2-2\" data-name=\"spec value: M-LWDF\">M-LWDF</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-3-2-3\" data-name=\"spec label: sensing\">sensing</span><span data-kid=\"1-2-3-2-2-1-3-2-4\" data-name=\"spec value: GRU filter\">GRU filter</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-1-3-2-5\" data-name=\"spec label: training\">training</span><span data-kid=\"1-2-3-2-2-1-3-2-6\" data-name=\"spec value: GRU\">GRU, supervised</span>\n</div>\n</div>\n<div class=\"ml-2 flex items-start pt-1\" data-kid=\"1-2-3-2-2-1-4\" data-name=\"annotation container: strongest overall\">\n<span class=\"whitespace-nowrap text-[10.5px] font-medium text-[#10171D]/70\" data-kid=\"1-2-3-2-2-1-4-1\" data-name=\"badge: strongest overall\">strongest overall</span>\n</div>\n</div>\n<!-- route B -->\n<div class=\"flex items-stretch\" data-kid=\"1-2-3-2-2-2\" data-name=\"route B: NeuroSpectrum multi-step row\">\n<div class=\"w-[218px] shrink-0 rounded-[14px] border border-[#10171D]/25 bg-white px-3 py-2\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"source configuration card: NeuroSpectrum\">\n<div class=\"whitespace-nowrap text-[12.5px] font-medium leading-4\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"config name: NeuroSpectrum\">NeuroSpectrum, hard sensing</div>\n<div class=\"mt-1 grid grid-cols-[62px_1fr] gap-x-1.5 text-[11px] leading-[13px]\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"config spec grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-1-2-1\" data-name=\"spec label: scheduler\">scheduler</span><span data-kid=\"1-2-3-2-2-2-1-2-2\" data-name=\"spec value: learned attention\">learned attention</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-1-2-3\" data-name=\"spec label: sensing\">sensing</span><span data-kid=\"1-2-3-2-2-2-1-2-4\" data-name=\"spec value: energy detector\">energy detector</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-1-2-5\" data-name=\"spec label: training\">training</span><span data-kid=\"1-2-3-2-2-2-1-2-6\" data-name=\"spec value: BC + PPO\">BC + PPO</span>\n</div>\n</div>\n<div class=\"flex w-[96px] shrink-0 flex-col items-center justify-center px-2\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"transformation step: clone teacher\">\n<div class=\"text-center text-[10px] leading-[12px] text-[#10171D]/60\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"transformation description\" data-reason=\"false\">clone teacher</div>\n<div class=\"mt-1 flex w-full items-center\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"connector arrow with line\">\n<span class=\"h-px flex-1 bg-[#10171D]/40\" data-kid=\"1-2-3-2-2-2-2-2-1\" data-name=\"connector line\"></span>\n<span class=\"text-[12px] leading-none text-[#10171D]/60\" data-kid=\"1-2-3-2-2-2-2-2-2\" data-name=\"arrow symbol\">→</span>\n</div>\n</div>\n<div class=\"w-[190px] shrink-0 rounded-[14px] border border-[#10171D]/25 bg-white px-3 py-2\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"intermediate configuration card: NeuroSpectrum\">\n<div class=\"text-[13px] font-medium leading-4\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"config name: NeuroSpectrum\">NeuroSpectrum, BC only</div>\n<div class=\"mt-1 grid grid-cols-[62px_1fr] gap-x-1.5 text-[11px] leading-[13px]\" data-kid=\"1-2-3-2-2-2-3-2\" data-name=\"config spec grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-3-2-1\" data-name=\"spec label: scheduler\">scheduler</span><span data-kid=\"1-2-3-2-2-2-3-2-2\" data-name=\"spec value: learned attention\">learned attention</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-3-2-3\" data-name=\"spec label: sensing\">sensing</span><span data-kid=\"1-2-3-2-2-2-3-2-4\" data-name=\"spec value: GRU filter\">GRU filter</span>\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-3-2-5\" data-name=\"spec label: training\">training</span><span data-kid=\"1-2-3-2-2-2-3-2-6\" data-name=\"spec value: BC\">BC</span>\n</div>\n</div>\n<div class=\"flex w-[92px] shrink-0 flex-col items-center justify-center px-2\" data-kid=\"1-2-3-2-2-2-4\" data-name=\"transformation step: PPO fine-tune\">\n<div class=\"text-center text-[10px] leading-[12px] text-[#10171D]/60\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-4-1\" data-name=\"transformation description\" data-reason=\"false\">PPO fine-tune</div>\n<div class=\"mt-1 flex w-full items-center\" data-kid=\"1-2-3-2-2-2-4-2\" data-name=\"connector arrow with line\">\n<span class=\"h-px flex-1 bg-[#10171D]/40\" data-kid=\"1-2-3-2-2-2-4-2-1\" data-name=\"connector line\"></span>\n<span class=\"text-[12px] leading-none text-[#10171D]/60\" data-kid=\"1-2-3-2-2-2-4-2-2\" data-name=\"arrow symbol\">→</span>\n</div>\n</div>\n<div class=\"w-[214px] shrink-0 rounded-[14px] border border-[#10171D]/25 bg-white px-3 py-2\" data-kid=\"1-2-3-2-2-2-5\" data-name=\"target configuration card: NeuroSpectrum\">\n<div class=\"text-[13px] font-medium leading-4\" data-kid=\"1-2-3-2-2-2-5-1\" data-name=\"config name: NeuroSpectrum\">NeuroSpectrum, BC + PPO</div>\n<div class=\"mt-1 grid grid-cols-[62px_1fr] gap-x-1.5 text-[11px] leading-[13px]\" data-kid=\"1-2-3-2-2-2-5-2\" data-name=\"config spec grid\">\n<span class=\"text-[#10171D]/55\" data-kid=\"1-2-3-2-2-2-5-2-1\" data-na